{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/finance-agent-workbench/finance-semantic-contract.schema.json",
  "title": "Finance semantic contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "contract_id",
    "report_alias",
    "status",
    "business_purpose",
    "grain",
    "keys",
    "snapshot_behavior",
    "date_roles",
    "ledgers",
    "hierarchies",
    "measures",
    "currency_rules",
    "sign_rules",
    "null_policy",
    "join_rules",
    "filters",
    "tolerances",
    "known_legacy_defects",
    "unresolved_questions",
    "evidence_refs"
  ],
  "properties": {
    "version": {"const": 1},
    "contract_id": {"type": "string", "minLength": 1},
    "report_alias": {"type": "string", "minLength": 1},
    "status": {"enum": ["draft", "approved", "blocked", "superseded"]},
    "business_purpose": {"type": "string", "minLength": 1},
    "grain": {"type": ["string", "null"]},
    "keys": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidates", "tested_unique_key", "duplicate_policy"],
      "properties": {
        "candidates": {"type": "array", "items": {"type": "array", "items": {"type": "string"}}},
        "tested_unique_key": {"type": ["array", "null"], "items": {"type": "string"}},
        "duplicate_policy": {"type": ["string", "null"]}
      }
    },
    "snapshot_behavior": {"type": ["string", "null"]},
    "date_roles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "meaning", "timezone_or_calendar"],
        "properties": {
          "name": {"type": "string"},
          "meaning": {"type": "string"},
          "timezone_or_calendar": {"type": ["string", "null"]}
        }
      }
    },
    "ledgers": {"type": "array", "items": {"type": "string"}},
    "hierarchies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["alias", "owner_alias", "as_of_rule", "effective_date_rule", "unmapped_policy"],
        "properties": {
          "alias": {"type": "string"},
          "owner_alias": {"type": ["string", "null"]},
          "as_of_rule": {"type": ["string", "null"]},
          "effective_date_rule": {"type": ["string", "null"]},
          "unmapped_policy": {"type": ["string", "null"]}
        }
      }
    },
    "measures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["alias", "formula", "aggregation", "blank_or_zero_denominator", "components"],
        "properties": {
          "alias": {"type": "string"},
          "formula": {"type": ["string", "null"]},
          "aggregation": {"type": ["string", "null"]},
          "blank_or_zero_denominator": {"type": ["string", "null"]},
          "components": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "currency_rules": {"type": "array", "items": {"type": "string"}},
    "sign_rules": {"type": "array", "items": {"type": "string"}},
    "null_policy": {"type": "array", "items": {"type": "string"}},
    "join_rules": {"type": "array", "items": {"type": "string"}},
    "filters": {"type": "array", "items": {"type": "string"}},
    "tolerances": {"type": "array", "items": {"type": "string"}},
    "known_legacy_defects": {"type": "array", "items": {"type": "string"}},
    "unresolved_questions": {"type": "array", "items": {"type": "string"}},
    "evidence_refs": {"type": "array", "items": {"type": "string"}}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "approved"}}, "required": ["status"]},
      "then": {
        "properties": {
          "grain": {"type": "string", "minLength": 1},
          "snapshot_behavior": {"type": "string", "minLength": 1},
          "keys": {
            "properties": {
              "tested_unique_key": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
              "duplicate_policy": {"type": "string", "minLength": 1}
            }
          },
          "unresolved_questions": {"maxItems": 0},
          "evidence_refs": {"minItems": 1}
        }
      }
    }
  ]
}
