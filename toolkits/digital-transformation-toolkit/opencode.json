{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "permission": {
    "*": "deny",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "glob": "allow",
    "grep": "allow",
    "question": "allow",
    "doom_loop": "ask",
    "edit": "deny",
    "bash": {
      "*": "deny",
      "powershell.exe -NoProfile -Command \"Write-Output OPENCODE_WINDOWS_OK\"": "ask",
      "powershell.exe -NoProfile -File ./powershell/test_toolkit_setup.ps1*": "ask",
      "powershell.exe -NoProfile -File ./powershell/run_model_inventory.ps1*": "ask",
      "powershell.exe -NoProfile -File ./powershell/run_dax_query_any_model.ps1*": "ask"
    },
    "external_directory": {
      "*": "deny",
      "~/PowerBI-Evidence/**": "ask"
    }
  }
}
